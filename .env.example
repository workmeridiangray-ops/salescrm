# Values printed by `npx supabase status` after `npm run db:start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Only used by tests, never shipped to the browser
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Billing (Razorpay): API keys from the Razorpay dashboard; webhook points at /api/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only the webhook route uses this. Keep it server-side.
SUPABASE_SERVICE_ROLE_KEY=
# Email (Brevo). Without these, invitation links are shown to the inviter instead of emailed.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Sales CRM
# Public base URL, used in emailed links
APP_URL=http://127.0.0.1:3000

# Webhook dispatcher: a scheduler calls POST /api/webhooks/dispatch every minute with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Also scheduled (same CRON_SECRET): POST /api/reports/dispatch hourly, POST /api/sequences/dispatch every 5 minutes
